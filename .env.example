# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never import it from
# a "use client" file — doing so would ship it to every visitor's browser.
# This app's admin dashboard uploads/edits/deletes videos as the logged-in
# admin user (via NEXT_PUBLIC_SUPABASE_ANON_KEY + Supabase Auth + the RLS
# policies in supabase/schema.sql), so this key is NOT required for normal
# operation. Only set it if you add a server-only script or API route that
# needs to bypass Row Level Security (e.g. a bulk-import job).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
